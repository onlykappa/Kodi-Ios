{
  "name": "Umbrella",
  "plugin": "plugin.video.umbrella",
  "priority": 100,
  "assert": {
    "play_movie": [
      "title",
      "year"
    ],
    "play_episode": [
      "showname",
      "season",
      "episode"
    ],
    "search_movie": [
      "title"
    ],
    "search_episode": [
      "showname"
    ]
  },
  "play_movie": [
    "plugin://plugin.video.umbrella/?action=movieSearch&query={title_url}",
    {
      "title": "(?i)^(\\[.*\\])?.*{title}.*(\\[.*\\])?$",
      "year": "{year}"
    }
  ],
  "play_episode": [
    "plugin://plugin.video.umbrella/?action=tvSearch&query={showname_url}",
    {
      "title": "(?i)^(\\[.*\\])?{showname}(\\[.*\\])?$"
    },
    {
      "return": "true",
      "season": "^{season}$",
      "episode": "^{episode}$"
    },
    {
      "season": "^{season}$"
    },
    {
      "season": "^{season}$",
      "episode": "^{episode}$"
    }
  ],
  "search_movie": [
    "plugin://plugin.video.umbrella/?action=movieSearch&query={title_url}",
    {
      "keyboard": "{title}"
    }
  ],
  "search_episode": [
    "plugin://plugin.video.umbrella/?action=tvSearch&query={showname_url}",
    {
      "keyboard": "{showname}"
    }
  ]
}
