<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
 <section id="service.kodi.ios.bootstrap">
  <category id="updates" label="Updates">
   <group id="1">
    <setting id="check_on_start" type="boolean" label="Check GitHub for a newer test build when Kodi starts"><level>0</level><default>true</default><control type="toggle"/></setting>
    <setting id="github_token" type="string" label="GitHub token (read-only; only needed while the repository is private)"><level>0</level><default/><constraints><allowempty>true</allowempty></constraints><control type="edit" format="string"><heading>GitHub token</heading><hidden>true</hidden></control></setting>
    <setting id="check_now" type="action" label="Check for updates now"><level>0</level><data>RunScript(special://xbmc/addons/service.kodi.ios.bootstrap/check_updates.py)</data><control type="button" format="action"/></setting>
   </group>
  </category>
  <category id="library" label="Library">
   <group id="1">
    <setting id="library_scan" type="action" label="Scan iPhone files for movies and shows"><level>0</level><data>RunScript(service.kodi.ios.bootstrap,library_scan)</data><control type="button" format="action"/><help>Scan Kodi Downloads or a folder available to Kodi. Missing movies and shows are uploaded to Google Drive; phone copies are removed only after the Drive files are verified.</help></setting>
    <setting id="library_refresh" type="action" label="Refresh Library"><level>0</level><data>RunPlugin(plugin://plugin.video.kodi.ios.watch/?action=library_refresh&amp;all=1)</data><control type="button" format="action"/></setting>
   </group>
  </category>
  <category id="drive" label="Google Drive">
   <group id="1">
    <setting id="prepare_downloads" type="boolean" label="Prepare downloaded movies and shows for Kodi and AirPlay"><level>0</level><default>true</default><control type="toggle"/><help>Scan on startup and after uploads. Prepare one seekable MP4 in the same Drive file, keeping the selected source resolution and compatible HDR. Follow progress in Notifications. Temporary phone space is required.</help></setting>
    <setting id="drive_upload" type="boolean" label="Upload the Elementum videos you keep to Google Drive › Kodi Downloads"><level>0</level><default>true</default><control type="toggle"/></setting>
    <setting id="drive_upload_delete" type="boolean" label="Remove the phone copy once Google Drive has it"><level>0</level><default>true</default><control type="toggle"/></setting>
    <setting id="background_transfers" type="boolean" label="Keep downloading and uploading while Kodi is in the background"><level>0</level><default>true</default><control type="toggle"/></setting>
   </group>
  </category>
  <category id="playback" label="Playback">
   <group id="1">
    <setting id="last_tv" type="string" label="Last TV used by Play on TV"><level>0</level><default/><constraints><allowempty>true</allowempty></constraints><control type="edit" format="string"><heading>Last TV</heading></control></setting>
    <setting id="airplay_button" type="boolean" label="Also show Apple's AirPlay audio button during playback"><level>0</level><default>false</default><control type="toggle"/></setting>
   </group>
  </category>
 </section>
</settings>
