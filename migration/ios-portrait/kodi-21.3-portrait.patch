+CGUIControl* CGUIBaseContainer::CrossScroller() const
+{
+  // Kodi-iOS: the nearest group list above this list that scrolls the other way, if any.
+  for (CGUIControl* parent = GetParentControl(); parent; parent = parent->GetParentControl())
+  {
+    if (parent->GetControlType() == GUICONTROL_GROUPLIST &&
+        static_cast<CGUIControlGroupList*>(parent)->GetOrientation() != m_orientation)
+      return parent;
+  }
