+float CGUIControlGroupList::ScrollPortrait(float distance)
+{
+  if (!IsPortraitShowPage())
+    return 0.0f;
+  ValidateOffset();
+  CGUIBaseContainer* episodes = nullptr;
+  for (CGUIControl* control : m_children)
+  {
+    if (control->IsVisible() && control->GetControlType() == GUICONTAINER_LIST &&
+        (control->GetID() == 52 || control->GetID() == 60))
+    {
+      episodes = static_cast<CGUIBaseContainer*>(control);
+      break;
+    }
+  }
+  const float before = m_scroller.GetValue();
+  float remaining = distance;
+  // Moving back first rewinds episodes, then restores the header, all in the same finger movement.
+  if (remaining < 0.0f && episodes)
+    remaining -= episodes->PortraitScroll(remaining);
+  const float limit = std::max(0.0f, m_totalSize - Size());
+  m_scroller.SetValue(std::max(0.0f, std::min(before + remaining, limit)));
+  const float moved = m_scroller.GetValue() - before;
+  remaining -= moved;
+  if (remaining > 0.0f && episodes)
+    remaining -= episodes->PortraitScroll(remaining);
+  SetInvalid();
+  return distance - remaining;
+}
