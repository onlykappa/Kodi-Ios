+// Kodi-iOS r11: the menus are portrait only (the skin ships a portrait layout); fullscreen video turns the
+// picture to landscape. The announcement thread sets s_videoLandscape when a video stream starts or stops, and
+// the main thread turns the screen to match, retrying every half second until it does.
+static std::atomic<bool> s_videoLandscape{false};
+
+// Kodi-iOS r7: Kodi's window is created with a fixed frame and autoresizing off, so when iOS turns the scene the
+// window (and this controller's view) kept the portrait size: Kodi then read a portrait screen size in landscape and
+// drew the picture into the bottom-left corner. The scene's bounds are the size the window must have.
+static CGRect InterfaceBounds(UIWindow* window)
+{
+  if (window.windowScene)
+    return window.windowScene.coordinateSpace.bounds;
+  return UIScreen.mainScreen.bounds;
+}
+
 - (UIInterfaceOrientationMask)supportedInterfaceOrientations
 {
-  return UIInterfaceOrientationMaskLandscape;
+  // Info.plist lists landscape too, or iOS could never turn the picture for playback.
+  if ([[IOSScreenManager sharedInstance] isExternalScreen] || s_videoLandscape)
+    return UIInterfaceOrientationMaskLandscape;
+  return UIInterfaceOrientationMaskPortrait;
+}
+
+- (void)setVideoLandscape:(BOOL)landscape
+{
+  // Any thread.
+  if (s_videoLandscape.exchange(landscape) != static_cast<bool>(landscape))
+    CLog::Log(LOGINFO, "Video orientation: {}", landscape ? "landscape" : "portrait");
+  dispatch_async(dispatch_get_main_queue(), ^{
+    [self applyVideoOrientation];
+  });
 }
+
+- (void)healScreenSize
+{
+  // Main thread, every half second: the GL view, its framebuffer and Kodi's resolution must all match the
+  // screen. One left behind after a rotation showed as Kodi drawing only part of the screen (the rest frozen);
+  // when they disagree twice in a row (not mid-rotation), apply the rotation again.
+  static int mismatches = 0;
+  if (!m_glView || [[IOSScreenManager sharedInstance] isExternalScreen])
+    return;
+  const CGSize want = InterfaceBounds(m_window).size;
+  const int pixelsWide = static_cast<int>(lround(want.width * screenScale));
+  const int pixelsHigh = static_cast<int>(lround(want.height * screenScale));
+  auto winSystem = CServiceBroker::GetWinSystem();
+  const bool kodiBehind = winSystem && (winSystem->GetGfxContext().GetWidth() != pixelsWide ||
+                                        winSystem->GetGfxContext().GetHeight() != pixelsHigh);
+  if (!CGSizeEqualToSize(m_window.bounds.size, want) || !CGSizeEqualToSize(m_glView.frame.size, want) || kodiBehind)
+  {
+    if (++mismatches >= 2)
+    {
+      mismatches = 0;
+      CLog::Log(LOGWARNING, "Screen size out of step ({} x {} wanted), applying it again", pixelsWide, pixelsHigh);
+      [self applyRotatedScreen];
+    }
+  }
+  else
+    mismatches = 0;
+}
+
+- (void)applyVideoOrientation
+{
+  // Main thread: ask iOS for the orientation the player needs while the screen does not have it yet.
+  static int failures = 0;
+  const bool want = s_videoLandscape;
+  UIWindowScene* scene = m_window.windowScene;
+  if (!scene || [[IOSScreenManager sharedInstance] isExternalScreen])
+    return;
+  if (static_cast<bool>(UIInterfaceOrientationIsLandscape(scene.interfaceOrientation)) == want)
+  {
+    failures = 0;
+    return;
+  }
+  if (@available(iOS 16.0, *))
+  {
+    [self setNeedsUpdateOfSupportedInterfaceOrientations];
+    auto prefs = [[UIWindowSceneGeometryPreferencesIOS alloc]
+        initWithInterfaceOrientations:want ? UIInterfaceOrientationMaskLandscape
+                                           : UIInterfaceOrientationMaskPortrait];
+    [scene requestGeometryUpdateWithPreferences:prefs
+                                   errorHandler:^(NSError* error) {
+                                     if (failures++ < 3)
+                                       CLog::Log(LOGWARNING, "Video orientation request refused: {}",
+                                                 error.localizedDescription.UTF8String);
+                                   }];
+  }
+  else
+  {
+    [[UIDevice currentDevice]
+        setValue:@(want ? UIInterfaceOrientationLandscapeRight : UIInterfaceOrientationPortrait)
+          forKey:@"orientation"];
+    [UIViewController attemptRotationToDeviceOrientation];
+  }
+}
+
+static void ApplyRotatedScreen(void*)
+{
+  // Runs on Kodi's application thread: re-read the screen size, rebuild the desktop
+  // resolution and switch to it, which re-lays out every window (GUI_MSG_WINDOW_RESIZE).
+  auto winSystem = dynamic_cast<CWinSystemIOS*>(CServiceBroker::GetWinSystem());
+  if (!winSystem)
+    return;
+  winSystem->ResetInternalScreenSize();
+  winSystem->UpdateResolutions();
+  [g_xbmcController setGUIInsetsFromMainThread:NO];
+  winSystem->GetGfxContext().SetVideoResolution(RES_DESKTOP, true);
+  CLog::Log(LOGINFO, "Screen rotated: {} x {}", winSystem->GetGfxContext().GetWidth(),
+            winSystem->GetGfxContext().GetHeight());
+}
+
+- (void)viewWillTransitionToSize:(CGSize)size
+       withTransitionCoordinator:(id<UIViewControllerTransitionCoordinator>)coordinator
+{
+  [super viewWillTransitionToSize:size withTransitionCoordinator:coordinator];
+  [coordinator animateAlongsideTransition:nil
+                               completion:^(id<UIViewControllerTransitionCoordinatorContext> context) {
+                                 [self applyRotatedScreen];
+                               }];
+}
+
+- (void)viewDidLayoutSubviews
+{
+  [super viewDidLayoutSubviews];
+  // Kodi-iOS r11: the GL view is created at launch with the landscape frame Kodi starts with and does not
+  // autoresize. When iOS lays the app out in portrait (launched upright, or any size change that is not a
+  // rotation transition), follow the view's real size so Kodi's framebuffer and resolution match the screen.
+  if (m_glView && (!CGSizeEqualToSize(m_glView.frame.size, self.view.bounds.size) ||
+                   !CGSizeEqualToSize(m_window.bounds.size, InterfaceBounds(m_window).size)))
+    [self applyRotatedScreen];
+}
+
+- (void)applyRotatedScreen
+{
+  if ([[IOSScreenManager sharedInstance] isExternalScreen] || !m_glView)
+    return;
+  const CGRect bounds = InterfaceBounds(m_window);
+  if (!CGRectEqualToRect(m_window.frame, bounds))
+    [m_window setFrame:bounds];
+  if (!CGRectEqualToRect(self.view.frame, m_window.bounds))
+    [self.view setFrame:m_window.bounds];
+  [m_glView setFrame:self.view.bounds];
+  [m_glView setScreen:m_glView.currentScreen withFrameBufferResize:YES];
+  if (CServiceBroker::GetAppMessenger())
+  {
+    static KODI::MESSAGING::ThreadMessageCallback callback = {ApplyRotatedScreen, nullptr};
+    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_CALLBACK, -1, -1, &callback);
+  }
+}
