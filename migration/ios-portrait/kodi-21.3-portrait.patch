diff --git a/xbmc/dialogs/GUIDialogKaiToast.cpp b/xbmc/dialogs/GUIDialogKaiToast.cpp
index 2f8ca00..af8137b 100644
--- a/xbmc/dialogs/GUIDialogKaiToast.cpp
