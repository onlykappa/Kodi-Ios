+// Kodi-iOS r12: in landscape video, taps reached Kodi only on the left of the screen (the portrait width). UIKit
+// hands a touch to a view only inside the bounds of every view above it; Kodi's window is made with a fixed frame
+// and autoresizing off, and a window or root view left at the portrait size lets the GL view draw everywhere but
+// receive touches only where the portrait frame was. The window and the root view accept every point of the screen
+// (and of their visible subviews) whatever their own size, so a touch always reaches the GL view.
+static BOOL KodiPointOnScreen(UIView* view, CGPoint point)
+{
+  UIWindow* window = [view isKindOfClass:UIWindow.class] ? (UIWindow*)view : view.window;
+  const CGSize screen = window.windowScene ? window.windowScene.coordinateSpace.bounds.size
+                                           : UIScreen.mainScreen.bounds.size;
+  CGRect area = CGRectUnion(view.bounds, CGRectMake(0, 0, screen.width, screen.height));
+  for (UIView* subview in view.subviews)
+  {
+    if (!subview.hidden)
+      area = CGRectUnion(area, subview.frame);
+  }
+  return CGRectContainsPoint(area, point);
+}
