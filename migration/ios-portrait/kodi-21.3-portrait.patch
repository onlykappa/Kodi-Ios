+
+// Kodi-iOS r19: the r12 bounds fix was not enough. Every tap the owner's logs show in landscape lies left of
+// 1206 px, the portrait width (the back button and back-10 worked; play/pause in the centre, forward 10 and the
+// top-right buttons never did, and those taps never reached Kodi at all). Something UIKit keeps at the portrait
+// size still refuses the point, even though the window, root view and GL view all report the landscape size. So
+// when nothing below the window claims a point on the screen (UIKit answers the window or the root view), the
+// touch goes to the GL view, which holds Kodi's gesture recognizers. A real view under the finger (the Liquid Glass
+// tab bar, the AirPlay button, a keyboard) still gets it first.
+static UIView* KodiGLView(UIWindow* window)
+{
+  for (UIView* subview in window.rootViewController.view.subviews)
+  {
+    if ([subview isKindOfClass:IOSEAGLView.class])
+      return subview;
+  }
+  return nil;
+}
