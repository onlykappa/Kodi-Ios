+// Kodi-iOS r11: the GUI follows the phone into portrait (the skin ships a portrait layout);
+// fullscreen video stays landscape.
+static bool PlayingVideo()
+{
+  const auto appPlayer = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  return appPlayer && appPlayer->IsPlayingVideo();
+}
+
 - (UIInterfaceOrientationMask)supportedInterfaceOrientations
 {
-  return UIInterfaceOrientationMaskLandscape;
+  if ([[IOSScreenManager sharedInstance] isExternalScreen] || PlayingVideo())
+    return UIInterfaceOrientationMaskLandscape;
+  return UIInterfaceOrientationMaskAllButUpsideDown;
+}
+
+static void ApplyRotatedScreen(void*)
+{
+  // Runs on Kodi's application thread: re-read the screen size, rebuild the desktop
+  // resolution and switch to it, which re-lays out every window (GUI_MSG_WINDOW_RESIZE).
+  auto winSystem = dynamic_cast<CWinSystemIOS*>(CServiceBroker::GetWinSystem());
+  if (!winSystem)
+    return;
+  winSystem->ResetInternalScreenSize();
+  winSystem->UpdateResolutions();
+  [g_xbmcController setGUIInsetsFromMainThread:NO];
+  winSystem->GetGfxContext().SetVideoResolution(RES_DESKTOP, true);
+  CLog::Log(LOGINFO, "Screen rotated: {} x {}", winSystem->GetGfxContext().GetWidth(),
+            winSystem->GetGfxContext().GetHeight());
+}
+
+- (void)viewWillTransitionToSize:(CGSize)size
+       withTransitionCoordinator:(id<UIViewControllerTransitionCoordinator>)coordinator
+{
+  [super viewWillTransitionToSize:size withTransitionCoordinator:coordinator];
+  [coordinator animateAlongsideTransition:nil
+                               completion:^(id<UIViewControllerTransitionCoordinatorContext> context) {
+                                 [self applyRotatedScreen];
+                               }];
+}
+
+- (void)applyRotatedScreen
+{
+  if ([[IOSScreenManager sharedInstance] isExternalScreen] || !m_glView)
+    return;
+  [m_glView setFrame:self.view.bounds];
+  [m_glView setScreen:m_glView.currentScreen withFrameBufferResize:YES];
+  if (CServiceBroker::GetAppMessenger())
+  {
+    static ThreadMessageCallback callback = {ApplyRotatedScreen, nullptr};
+    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_CALLBACK, -1, -1, &callback);
+  }
+}
+
+- (void)updateVideoOrientationLock
+{
+  // Called on the main thread when playback starts or stops.
+  if (@available(iOS 16.0, *))
+  {
+    [self setNeedsUpdateOfSupportedInterfaceOrientations];
+    if (PlayingVideo() && m_window.windowScene)
+    {
+      auto prefs = [[UIWindowSceneGeometryPreferencesIOS alloc]
+          initWithInterfaceOrientations:UIInterfaceOrientationMaskLandscape];
+      [m_window.windowScene requestGeometryUpdateWithPreferences:prefs
+                                                    errorHandler:nil];
+    }
+  }
+  else
+    [UIViewController attemptRotationToDeviceOrientation];
 }
