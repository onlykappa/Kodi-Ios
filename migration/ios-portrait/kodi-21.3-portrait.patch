 #include <mutex>

+#include <sys/stat.h>
+
 #define POPUP_ICON                400
 #define POPUP_CAPTION_TEXT        401
 #define POPUP_NOTIFICATION_BUTTON 402

+namespace
+{
+// iOS portrait build: pop-ups are never shown. Each one is appended as a JSON line to toasts.jsonl in the
+// bootstrap service's data folder (created here on a first start, before the service runs), and the service
+// moves them into the app's notification center (the bell). Returns false only if the pop-up could not be
+// recorded, so a message is never lost silently.
+bool KeepForBell(CGUIDialogKaiToast::eMessageType type,
+                 const std::string& image,
+                 const std::string& caption,
+                 const std::string& description)
+{
+  const std::string data = CSpecialProtocol::TranslatePath("special://profile/addon_data/");
+  if (data.empty())
+    return false;
+  const std::string dir = data + "service.kodi.ios.bootstrap/";
+  mkdir(data.c_str(), 0755); // already there on every start but the first: EEXIST is fine
+  mkdir(dir.c_str(), 0755);
+  struct stat info;
+  if (stat(dir.c_str(), &info) != 0 || !S_ISDIR(info.st_mode))
+    return false;
+
+  CVariant entry(CVariant::VariantTypeObject);
+  entry["time"] = static_cast<int64_t>(std::time(nullptr));
+  entry["type"] = type == CGUIDialogKaiToast::Error     ? "error"
+                  : type == CGUIDialogKaiToast::Warning ? "warning"
+                  : type == CGUIDialogKaiToast::Info    ? "info"
+                                                        : "default";
+  entry["image"] = image;
+  entry["caption"] = caption;
+  entry["description"] = description;
+  std::string line;
+  if (!CJSONVariantWriter::Write(entry, line, true))
+    return false;
+
+  std::ofstream out(dir + "toasts.jsonl", std::ios::out | std::ios::app | std::ios::binary);
+  if (!out)
+    return false;
+  out << line << '\n';
+  out.flush();
+  return static_cast<bool>(out);
+}
+} // namespace
