+  int minimum = 0, maximum = 0;
+  GetOffsetRange(minimum, maximum);
+  const float before = m_scroller.GetValue();
+  const int selected = CorrectOffset(GetOffset(), GetCursor());
+  m_scroller.SetValue(std::max(0.0f, std::min(before + distance, std::max(0, maximum) * size)));
+  SetOffset(static_cast<int>(std::floor(m_scroller.GetValue() / size)));
+  ValidateOffset();
+  // Preserve selection without emitting focus messages that would jump the page to the episode viewport.
+  CGUIBaseContainer::SetCursor(selected - CorrectOffset(GetOffset(), 0));
+  m_lastScrollStartTimer.Stop();
+  m_scrollTimer.Start();
+  SetInvalid();
+  return m_scroller.GetValue() - before;
