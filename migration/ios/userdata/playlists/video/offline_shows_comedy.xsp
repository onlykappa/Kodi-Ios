<smartplaylist type="tvshows">
  <name>Downloaded Shows - Comedy</name>
  <match>all</match>
  <rule field="path" operator="startswith">
    <value>special://profile/media/local_media_root_03/</value>
  </rule>
  <rule field="genre" operator="contains">
    <value>Comedy</value>
  </rule>
  <order direction="descending">dateadded</order>
</smartplaylist>
